config global 'global'
	option enabled '1'
	option ip_check_url 'https://api.ipify.org'
	option redial_wait '3'
	option rotate_mode 'round_robin'

config account 'acc001'
	option enabled '1'
	option name 'l2tp_001'
	option server '1.2.3.4'
	option username 'user001'
	option password 'pass001'
	option group 'default'
	option metric '101'
	option mtu '1400'

config account 'acc002'
	option enabled '0'
	option name 'l2tp_002'
	option server '5.6.7.8'
	option username 'user002'
	option password 'pass002'
	option group 'default'
	option metric '102'
	option mtu '1400'

config binding 'phone01'
	option enabled '1'
	option ssid 'SSID-01'
	option network 'lan10'
	option subnet '192.168.10.0/24'
	option account 'acc001'
	option rotate_mode 'manual'

config pool 'default'
	option enabled '1'
	list account 'acc001'
	list account 'acc002'
	option mode 'round_robin'
